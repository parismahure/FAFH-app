# Sourced by the "Bundle React Native code and images" build phase.
#
# Xcode does not load your shell profile, so a Node installed through a
# version manager (fnm, nvm, asdf) is not on its PATH — its PATH is only
# Xcode's own toolchain plus /usr/local/bin and /usr/bin. Without this file
# the build phase fails with "node: command not found".
#
# This project needs Node 16: expo-cli@5 refuses to run above it. See CLAUDE.md.
#
# Machine-specific overrides belong in .xcode.env.local, which is gitignored.
# That file wins, because it is sourced after this one.

if [[ -z "$NODE_BINARY" ]]; then
  # Prefer an fnm-managed Node 16, which is what this project is built with.
  _fnm_node16=$(ls -d "$HOME"/.local/share/fnm/node-versions/v16.*/installation/bin/node 2>/dev/null | tail -1)

  if [[ -n "$_fnm_node16" && -x "$_fnm_node16" ]]; then
    export NODE_BINARY="$_fnm_node16"
  elif command -v node >/dev/null 2>&1; then
    export NODE_BINARY="$(command -v node)"
  elif [[ -x /opt/homebrew/bin/node ]]; then
    export NODE_BINARY=/opt/homebrew/bin/node
  elif [[ -x /usr/local/bin/node ]]; then
    export NODE_BINARY=/usr/local/bin/node
  fi
fi
